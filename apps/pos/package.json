{
  "name": "@inkypos/pos",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "expo": "~58.0.16",
    "expo-camera": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "fake-indexeddb": "^6.2.6",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "doctor": "expo-doctor",
    "lint": "eslint src"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@inkypos/core$": "<rootDir>/../../packages/core/src/index.ts",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@noble/(.*)$": "<rootDir>/node_modules/@noble/$1"
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "testTimeout": 20000,
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@noble/.*)"
    ]
  }
}
