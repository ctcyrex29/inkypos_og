              "schema_version",
              "event_id",
              "device_sequence",
              "occurred_at",
              "tenant_id",
              "branch_id",
              "register_id",
              "device_id",
              "actor_user_id",
              "aggregate_id",
              "event_type",
              "payload"
            ],
            "additionalProperties": false
