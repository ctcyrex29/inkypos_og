                        "method_code": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 32
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "recorded",
                            "pending_confirmation",
                            "confirmed",
                            "failed",
                            "voided"
                          ]
                        },
                        "currency": {
                          "type": "string",
                          "enum": [
                            "USD",
                            "ZWG",
                            "ZAR",
                            "BWP"
                          ]
                        },
                        "amount_minor": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "sale_currency_amount_minor": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "exchange_rate": {
                          "type": "string",
                          "pattern": "^\\d+(\\.\\d{1,8})?$"
                        },
                        "exchange_rate_version": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "reference": {
                          "type": "string",
                          "maxLength": 128
                        }
