                  "receipt_number",
                  "currency",
                  "rounding",
                  "catalogue_version",
                  "price_list_version",
                  "completed_at",
                  "lines",
                  "totals",
                  "payments",
                  "change_minor",
                  "stock_movements"
                ],
                "additionalProperties": false
              }
